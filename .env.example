# Copy to .env and adjust. Used by docker-compose and the backend.

# Postgres
POSTGRES_USER=wms
POSTGRES_PASSWORD=wms_secret
POSTGRES_DB=wms
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Default admin seeded on first run
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# Seed demo users (manager/worker) and sample warehouse data.
# Set to false for production so only the admin account is created.
SEED_DEMO=true

# Frontend (build-time): base URL the browser uses to reach the API
VITE_API_URL=http://localhost:4000/api

# --- Production only (docker-compose.prod.yml) ---
# Public address Caddy serves. Use a hostname for automatic HTTPS, or :80 for
# plain HTTP by IP. Example: SITE_ADDRESS=wms.example.com
SITE_ADDRESS=:80
