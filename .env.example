# Copy to .env and adjust. Used by docker-compose and the backend.

# Postgres
POSTGRES_USER=wms
POSTGRES_PASSWORD=wms_secret
POSTGRES_DB=wms

# Backend database connection (Prisma). In Docker this is derived from the
# POSTGRES_* vars above; set it directly for local `npm run dev`.
DATABASE_URL=postgresql://wms:wms_secret@localhost:5432/wms

# Auth — use long random strings in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Default admin seeded on first run
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# Seed demo users (manager/operator/picker/controller) and sample warehouse
# data. Set to false in production so only the admin account is created.
SEED_DEMO=true

# CORS origin the browser calls from (dev proxy handles this automatically).
CORS_ORIGIN=http://localhost:8080

# --- Production only (docker-compose.prod.yml) ---
# Public address Caddy serves. Use a hostname for automatic HTTPS, or :80 for
# plain HTTP by IP. Example: SITE_ADDRESS=wms.example.com
SITE_ADDRESS=:80
