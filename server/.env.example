# Copy to server/.env and adjust. Used by the Trade Journal backend.

PORT=4100
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=journal
POSTGRES_PASSWORD=journal_secret
POSTGRES_DB=journal

# Seed a demo account (demo@journal.app / demo1234) on first run. Off in prod.
SEED_DEMO=true

# Where uploaded screenshots are stored on disk.
UPLOAD_DIR=uploads
